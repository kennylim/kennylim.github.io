---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Layout title="Writing — Ken Lim" description="Essays, notes and field reports from Ken Lim.">
  <div class="pt-14 pb-8">
    <p class="font-mono text-[11px] uppercase tracking-[0.35em] text-[#03aa5c] dark:text-[#3cc287]">04 — Writing</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight text-stone-900 dark:text-stone-100">Essays &amp; field notes<span class="text-stone-300">.</span></h1>
    <p class="mt-3 text-[15.5px] leading-relaxed text-stone-500 dark:text-stone-400">Everything I've published, newest first.</p>
  </div>
  <div class="border-t border-stone-200/80 pt-10 dark:border-stone-800">
    <ul class="mt-2 max-w-2xl space-y-8">
      {
        posts.map((p) => (
          <li>
            <a href={`/writing/${p.id}/`} class="group block">
              <span class="font-mono text-xs text-stone-400 dark:text-stone-500">
                {p.data.date.toISOString().slice(0, 10)}
                {p.data.tags.length > 0 && <span> · {p.data.tags.join(" · ")}</span>}
              </span>
              <h2 class="mt-1 text-xl font-semibold group-hover:text-[#03aa5c]">{p.data.title}</h2>
              <p class="mt-1 text-stone-500 dark:text-stone-400">{p.data.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
