---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
import Layout from "../layouts/Layout.astro";
import FlowDiagram from "../components/FlowDiagram.astro";
---
<Layout title="Ken Lim — What I do" description="A six-stage data-to-AI workflow: understand & plan, data platform, BI & data products, ML platform & models, AI products, and lead & operate.">

  <section class="pt-14 pb-8 sm:pt-20">
    <p class="font-displaymono text-[10px] uppercase tracking-[0.35em] text-stone-400">03 — the work</p>
    <h1 class="mt-2 text-4xl font-semibold tracking-tight text-stone-900 dark:text-stone-100">What I do<span class="text-stone-300">.</span></h1>
  </section>

  <section class="border-t border-stone-200/80 py-12 dark:border-stone-800" data-reveal>
    <FlowDiagram />
    <p class="mt-8 font-mono text-[12px] text-stone-500 dark:text-stone-400">
      Where I've done it → <a class="text-[#03aa5c] hover:underline dark:text-[#3cc287]" href={base + "/experience"}>Experience</a>
    </p>
  </section>

</Layout>
