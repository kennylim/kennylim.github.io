---
interface Props { caption: string }
const { caption } = Astro.props;
const stops = [
  { t: "Sources", s: "app DBs · SaaS · events", g: "" },
  { t: "Change bus", s: "Debezium/Kafka · registry gate", g: "contract ①" },
  { t: "Raw (bronze)", s: "Iceberg append · schema-on-arrival", g: "" },
  { t: "Arrival signal", s: "sync-done · webhook · asset · commit", g: "" },
  { t: "dbt / SQLMesh", s: "microbatch MERGE · SCD2 · audits", g: "contract ②" },
  { t: "Serving (gold)", s: "metrics · features · agents · BI", g: "contract ③" },
];
---
<figure class="not-prose my-8">
  <div class="rounded-2xl border border-stone-200 bg-gradient-to-b from-white to-stone-100/60 p-4 dark:border-stone-800 dark:from-zinc-900 dark:to-zinc-950 sm:p-6">
    <div class="flex flex-col gap-2 md:flex-row md:items-stretch">
      {stops.map((st, i) => (
        <div class="contents">
          <div class="relative min-w-0 flex-1 rounded-lg border border-stone-200 bg-white px-3 py-2.5 dark:border-stone-800 dark:bg-zinc-900">
            <p class="text-[12.5px] font-semibold text-stone-800 dark:text-stone-100">{st.t}</p>
            <p class="mt-0.5 font-mono text-[10px] leading-snug text-stone-400 dark:text-stone-500">{st.s}</p>
            {st.g && <span class="absolute -top-2 right-2 rounded-full bg-[#93a883] px-2 py-0.5 font-mono text-[8.5px] uppercase tracking-wider text-white dark:bg-[#6f8365]">{st.g}</span>}
          </div>
          {i < stops.length - 1 && (
            <span class="flex items-center justify-center font-mono text-stone-300 md:px-0 md:text-[13px] dark:text-stone-600"><span class="rotate-90 md:rotate-0">→</span></span>
          )}
        </div>
      ))}
    </div>
    <p class="mt-4 text-center font-mono text-[10.5px] uppercase tracking-[0.18em] text-stone-400 dark:text-stone-500">
      signal-driven, not cron-driven — transformation runs when the data says it's there
    </p>
  </div>
  <figcaption class="mt-3 text-center text-xs text-stone-500 dark:text-stone-400">{caption}</figcaption>
</figure>
