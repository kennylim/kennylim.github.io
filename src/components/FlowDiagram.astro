---
const stages = [
  {
    n: "01", title: "Understand", icon: "doc",
    items: [
      "Problem discovery with the people who own it",
      "Audit of the current state, gaps and constraints",
      "Feasible architectures, costed and documented",
    ],
  },
  {
    n: "02", title: "Data platform", icon: "db", medallion: true,
    items: [
      "Ingestion — batch, CDC and streaming",
      "Lakehouse and warehouse on open table formats",
      "Medallion modeling with dbt, Spark and Trino",
      "Data quality, contracts, catalog, lineage and access",
      "Deployed as code; scaled and administered in production",
    ],
  },
  {
    n: "03", title: "BI & data products", icon: "chart",
    items: [
      "One governed semantic layer for metrics",
      "Datasets and APIs shipped as products",
      "Dashboards and self-service, with SLAs",
    ],
  },
  {
    n: "04", title: "ML platform & models", icon: "nn",
    items: [
      "Feature stores and vector search",
      "Training and fine-tuning pipelines",
      "Evals, registries and scalable serving",
      "Model and data drift monitoring",
    ],
  },
  {
    n: "05", title: "AI products", icon: "spark",
    items: [
      "RAG systems and agents (MCP, LangGraph)",
      "ML-powered features in production",
      "Guardrails, lineage and audit trails",
    ],
  },
];
---
<figure class="select-none">
  <!-- axis -->
  <div class="mb-4 flex items-center justify-between font-mono text-[10px] uppercase tracking-[0.22em]">
    <span class="text-stone-400 dark:text-stone-500">raw data</span>
    <span class="text-[#6f8365] dark:text-[#a8bd97]">shipped AI</span>
  </div>

  <!-- the five stages -->
  <div class="relative">
    <div class="absolute inset-x-0 top-8 hidden h-px bg-gradient-to-r from-stone-300 via-[#d3b98c] to-[#93a883] lg:block dark:from-stone-700 dark:via-[#8a7a5c] dark:to-[#6f8365]">
      <span class="flow-dot absolute top-1/2 h-1.5 w-1.5 -translate-y-1/2 rounded-full bg-[#c9a96e]"></span>
      <span class="flow-dot flow-dot-2 absolute top-1/2 h-1.5 w-1.5 -translate-y-1/2 rounded-full bg-[#93a883]"></span>
    </div>
    <ol class="relative grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {stages.map((st) => (
        <li class="rounded-xl border border-[#eae2d0] bg-[#fffdf7] p-4 shadow-[0_1px_3px_rgba(120,100,60,0.06)] transition-transform duration-300 hover:-translate-y-0.5 dark:border-stone-800 dark:bg-zinc-900">
          <div class="flex items-center justify-between">
            <span class="grid h-7 w-7 place-items-center rounded-full bg-[#eef1e8] dark:bg-[#2b3126]">
              <svg class="h-[15px] w-[15px] text-[#7d8f6f] dark:text-[#a8bd97]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                {st.icon === "doc" && <path d="M7 3h10v18H7zM10 8h4M10 12h4M10 16h2"/>}
                {st.icon === "db" && <g><ellipse cx="12" cy="5.5" rx="7" ry="2.8"/><path d="M5 5.5v13c0 1.5 3.1 2.8 7 2.8s7-1.3 7-2.8v-13M5 12c0 1.5 3.1 2.8 7 2.8s7-1.3 7-2.8"/></g>}
                {st.icon === "chart" && <path d="M4 20V10M10 20V4M16 20v-8M21 20H3"/>}
                {st.icon === "nn" && <g><circle cx="5" cy="6" r="1.6"/><circle cx="5" cy="18" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="6" r="1.6"/><circle cx="19" cy="18" r="1.6"/><path d="M6.5 6.8 10.6 11M6.5 17.2 10.6 13M13.4 11 17.5 6.8M13.4 13l4.1 4.2" opacity=".7"/></g>}
                {st.icon === "spark" && <path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/>}
              </svg>
            </span>
            <span class="font-mono text-[10px] tracking-[0.25em] text-stone-400 dark:text-stone-500">{st.n}</span>
          </div>
          <h3 class="mt-2.5 text-[14.5px] font-semibold text-stone-800 dark:text-stone-100">{st.title}</h3>
          {st.medallion && (
            <div class="mt-1.5 flex gap-1.5" title="bronze → silver → gold">
              <span class="h-1 w-5 rounded-full bg-[#b07b4a]/70"></span>
              <span class="h-1 w-5 rounded-full bg-[#9ea3ab]/70"></span>
              <span class="h-1 w-5 rounded-full bg-[#c9a96e]"></span>
            </div>
          )}
          <ul class="mt-2.5 space-y-1.5">
            {st.items.map((it) => (
              <li class="flex gap-2 text-[12.5px] leading-snug text-stone-600 dark:text-stone-300">
                <span class="mt-[5px] h-1.5 w-1.5 shrink-0 rounded-full bg-[#93a883] dark:bg-[#6f8365]"></span>
                <span>{it}</span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</figure>

<style>
  .flow-dot { left: 0; animation: flow 6s linear infinite; opacity: 0.85; }
  .flow-dot-2 { animation-delay: 3s; }
  @keyframes flow {
    0% { left: -2%; opacity: 0; }
    5% { opacity: 0.85; }
    95% { opacity: 0.85; }
    100% { left: 102%; opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .flow-dot { display: none; }
  }
</style>
