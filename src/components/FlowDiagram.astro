---
const stages = [
  {
    n: "01", title: "Understand & plan", icon: "doc",
    items: [
      "Stakeholder discovery and requirements",
      "Data and platform audits",
      "Gap analysis, current to target state",
      "Strategy, roadmaps and costed architectures",
    ],
  },
  {
    n: "02", title: "Data platform", icon: "db", medallion: true,
    items: [
      "Lakehouse, lakebase and warehouse (Iceberg, Snowflake, Databricks)",
      "Batch and streaming pipelines (Airflow, dbt, Spark, Kafka, Flink)",
      "Curated models: Medallion, dimensional, Data Mesh",
      "Master data and entity resolution",
      "Governance: contracts, quality, lineage, access and compliance",
      "Microservices and APIs on Kubernetes",
    ],
  },
  {
    n: "03", title: "BI & data products", icon: "chart",
    items: [
      "Semantic layer and governed metrics",
      "Data products with owners, contracts and SLAs",
      "Self-service discovery through catalogs",
      "Adoption and value tracked with KPIs",
    ],
  },
  {
    n: "04", title: "ML platform & models", icon: "nn",
    items: [
      "Feature stores and vector search",
      "Custom models, trained and tuned (PyTorch, MLflow)",
      "Fine-tuning, evals and model registries",
      "Experimentation and MLOps CI/CD",
      "Scalable serving and inference (vLLM)",
      "Model and data drift monitoring",
    ],
  },
  {
    n: "05", title: "AI products", icon: "spark",
    items: [
      "RAG grounded in governed data",
      "Agents and multi-agent systems with MCP (LangGraph)",
      "ML and LLM features in production products",
      "Prompt versioning, evals and tracing",
      "Guardrails and audit trails (NIST AI RMF)",
      "Token, latency and GPU cost optimization",
    ],
  },
  {
    n: "06", title: "Lead & operate", icon: "users",
    items: [
      "Build and mentor high-performing data and AI teams",
      "Lead onshore and offshore partners",
      "Observability and SLOs (Prometheus, Grafana)",
      "Incident response and reliability",
      "FinOps for data and AI spend",
    ],
  },
];

---
<figure class="select-none">
  <div class="relative">
    <!-- the flow spine -->
    <div class="absolute left-[27px] top-4 bottom-4 w-px bg-gradient-to-b from-stone-300 via-stone-300 to-[#03aa5c]/60 dark:from-stone-700" aria-hidden="true">
    </div>

    <ol data-reveal class="stagger relative space-y-5">
      {stages.map((st) => (
        <li class="group/card relative flex items-start gap-4">
          <span class="relative z-10 grid h-14 w-14 shrink-0 place-items-center rounded-xl border border-stone-200/70 bg-[#fbf9f3] transition-all duration-300 group-hover/card:border-[#03aa5c] group-hover/card:shadow-md dark:border-stone-800 dark:bg-stone-900">
            <svg class="h-5 w-5 text-[#03aa5c] dark:text-[#3cc287]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              {st.icon === "doc" && <path d="M7 3h10v18H7zM10 8h4M10 12h4M10 16h2"/>}
              {st.icon === "db" && <g><ellipse cx="12" cy="5.5" rx="7" ry="2.8"/><path d="M5 5.5v13c0 1.5 3.1 2.8 7 2.8s7-1.3 7-2.8v-13M5 12c0 1.5 3.1 2.8 7 2.8s7-1.3 7-2.8"/></g>}
              {st.icon === "chart" && <path d="M4 20V10M10 20V4M16 20v-8M21 20H3"/>}
              {st.icon === "nn" && <g><circle cx="5" cy="6" r="1.6"/><circle cx="5" cy="18" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="6" r="1.6"/><circle cx="19" cy="18" r="1.6"/><path d="M6.5 6.8 10.6 11M6.5 17.2 10.6 13M13.4 11 17.5 6.8M13.4 13l4.1 4.2" opacity=".7"/></g>}
              {st.icon === "spark" && <path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/>}
              {st.icon === "users" && <g><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></g>}
            </svg>
            <span class="absolute -right-1.5 -top-1.5 rounded-full border border-stone-200 bg-[#fbf9f3] px-1.5 font-mono text-[9px] tracking-widest text-stone-400 dark:border-stone-700 dark:bg-stone-900">{st.n}</span>
          </span>
          <div class="min-w-0 flex-1 rounded-xl border border-stone-200/70 bg-[#fbf9f3] p-5 transition-all duration-300 group-hover/card:border-stone-300 group-hover/card:shadow-sm dark:border-stone-800 dark:bg-stone-900 dark:group-hover/card:border-stone-100">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
              <h3 class="text-[15px] font-semibold tracking-tight text-stone-800 dark:text-stone-100">{st.title}</h3>
              {st.medallion && (
                <span class="flex gap-1" title="bronze → silver → gold">
                  <span class="h-1 w-5 rounded-full bg-[#9a9a9a]/70"></span>
                  <span class="h-1 w-5 rounded-full bg-[#c9c9c9]/70"></span>
                  <span class="h-1 w-5 rounded-full bg-[#03aa5c]"></span>
                </span>
              )}
            </div>
            <ul class="mt-3 grid gap-x-8 gap-y-1.5 sm:grid-cols-2">
              {st.items.map((it) => (
                <li class="flex gap-2 text-[13px] leading-snug text-stone-600 dark:text-stone-300">
                  <span class="mt-[6px] h-1.5 w-1.5 shrink-0 rounded-full bg-[#03aa5c]"></span>
                  <span>{it}</span>
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>

    <!-- end -->
    <div class="relative mt-5 flex items-center gap-4">
      <span class="relative z-10 grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-[#03aa5c] text-white ">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg>
      </span>
      <p class="font-displaymono text-[10px] uppercase tracking-[0.3em] text-[#03aa5c] dark:text-[#3cc287]">data &amp; AI products out — in production</p>
    </div>
  </div>
</figure>


