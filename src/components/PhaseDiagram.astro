const k = kinds[Astro.props.kind];
interface Props { kind: string; caption: string }
const { caption } = Astro.props;
const stroke = "currentColor";
---
<figure class="not-prose my-8">
  <svg viewBox={k.vb} role="img" style="width:100%;height:auto;font-family:ui-sans-serif,system-ui,sans-serif" aria-label={caption}>
    <defs>
      <marker id="arr-{Astro.props.kind}" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill={stroke} opacity="0.5"/>
      </marker>
      <marker id="arrc-{Astro.props.kind}" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill="#a9705c"/>
      </marker>
    </defs>
    {k.nodes.map((n) => (
      <g>
        <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="7"
          fill={n.accent === "sage" ? "#93a883" : n.accent === "clay" ? "#a9705c" : stroke}
          fill-opacity={n.accent ? "0.14" : "0.06"}
          stroke={n.accent === "sage" ? "#7d8f6f" : n.accent === "clay" ? "#a9705c" : stroke}
          stroke-opacity="0.55" stroke-width="1.2" />
        <text x={n.x + n.w / 2} y={n.y + (n.t2 ? n.h / 2 - 2 : n.h / 2 + 4)} text-anchor="middle" font-size="11.5" fill={stroke}>{n.t1}</text>
        {n.t2 && <text x={n.x + n.w / 2} y={n.y + n.h / 2 + 13} text-anchor="middle" font-size="9.5" fill={stroke} opacity="0.6">{n.t2}</text>}
      </g>
    ))}
    {k.edges.map((e) => (
      <g>
        <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2}
          stroke={e.clay ? "#a9705c" : stroke} stroke-width="1.2"
          stroke-dasharray={e.dashed ? "4 4" : undefined}
          opacity={e.clay ? "0.8" : "0.45"}
          marker-end={e.clay ? `url(#arrc-${Astro.props.kind})` : `url(#arr-${Astro.props.kind})`} />
        {e.l && (
          <text x={(e.x1 + e.x2) / 2} y={(e.y1 + e.y2) / 2 - 6} text-anchor="middle" font-size="9.5" fill={e.clay ? "#a9705c" : stroke} opacity="0.75">{e.l}</text>
        )}
      </g>
    ))}
    {k.notes.map((n) => (
      <text x={n.x} y={n.y} text-anchor={n.anchor ?? "start"} font-size="10.5" font-style="italic" fill={n.clay ? "#a9705c" : n.sage ? "#7d8f6f" : stroke} opacity="0.9">{n.t}</text>
    ))}
  </svg>
  <figcaption class="mt-2 text-center text-xs text-stone-500 dark:text-stone-400">{caption}</figcaption>
</figure>
