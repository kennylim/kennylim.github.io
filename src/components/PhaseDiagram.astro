interface Edge { x1: number; y1: number; x2: number; y2: number; l?: string; dashed?: boolean; clay?: boolean }
interface Note { x: number; y: number; t: string; clay?: boolean; sage?: boolean; anchor?: "start" | "middle" | "end" }
interface Kind { nodes: Node[]; edges: Edge[]; notes: Note[]; vb: string }

