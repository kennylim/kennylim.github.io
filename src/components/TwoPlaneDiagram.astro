---
interface Props { caption: string }
const { caption } = Astro.props;
---
<figure class="not-prose my-8">
  <svg viewBox="0 0 640 190" role="img" style="width:100%;height:auto;font-family:ui-sans-serif,system-ui,sans-serif" aria-label="Two planes: the log for now, the table for always">
    <rect x="16" y="22" width="608" height="56" rx="9" fill="#a9705c" fill-opacity="0.08" stroke="#a9705c" stroke-opacity="0.5" stroke-width="1.2"/>
    <text x="36" y="45" font-size="12" font-weight="600" fill="currentColor">Kappa plane — the log, for now</text>
    <text x="36" y="63" font-size="10.5" fill="currentColor" opacity="0.6">apps &amp; events → Debezium/CDC → Rust streaming DB (RisingWave/Materialize, state on S3) → features, embeddings, agent context</text>
    <line x1="120" y1="78" x2="120" y2="112" stroke="currentColor" stroke-width="1.2" opacity="0.35"/>
    <path d="M116 86l4 8 4-8z" fill="currentColor" opacity="0.5"/>
    <line x1="520" y1="112" x2="520" y2="78" stroke="currentColor" stroke-width="1.2" opacity="0.35"/>
    <path d="M516 104l4-8 4 8z" fill="currentColor" opacity="0.5"/>
    <rect x="16" y="112" width="608" height="56" rx="9" fill="#93a883" fill-opacity="0.12" stroke="#7d8f6f" stroke-opacity="0.55" stroke-width="1.2"/>
    <text x="36" y="135" font-size="12" font-weight="600" fill="currentColor">Lambda-of-truth — the table, for always</text>
    <text x="36" y="153" font-size="10.5" fill="currentColor" opacity="0.6">same events → Iceberg v3 (row lineage) / DuckLake → models, metrics, evals, audit, replay &amp; reconciliation</text>
    <text x="320" y="185" text-anchor="middle" font-size="9.5" fill="currentColor" opacity="0.5">fresh by the log · checked by the table · one schema contract between the planes</text>
  </svg>
  <figcaption class="mt-3 text-center text-xs text-stone-500 dark:text-stone-400">{caption}</figcaption>
</figure>
