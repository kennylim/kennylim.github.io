---
interface Props { caption: string }
const { caption } = Astro.props;
---
<figure class="not-prose my-8">
<svg viewBox="0 0 660 252" role="img" aria-label="Timeline of data architecture generations from 1970 to 2026" style="width:100%;height:auto;font-family:ui-sans-serif,system-ui,sans-serif">
  <!-- era bands -->
  <g>
    <rect x="10"  y="66" width="103" height="72" rx="6" fill="currentColor" opacity="0.06"/>
    <rect x="118" y="66" width="103" height="72" rx="6" fill="currentColor" opacity="0.08"/>
    <rect x="226" y="66" width="103" height="72" rx="6" fill="currentColor" opacity="0.06"/>
    <rect x="334" y="66" width="103" height="72" rx="6" fill="currentColor" opacity="0.08"/>
    <rect x="442" y="66" width="103" height="72" rx="6" fill="currentColor" opacity="0.06"/>
    <rect x="550" y="66" width="100" height="72" rx="6" fill="#93a883" opacity="0.18"/>
  </g>
  <!-- spine -->
  <line x1="10" y1="150" x2="650" y2="150" stroke="currentColor" stroke-width="1" opacity="0.25"/>
  <path d="M644 145l10 5-10 5z" fill="currentColor" opacity="0.35"/>
  <!-- era labels (above) -->
  <g font-size="9" letter-spacing="1.4" text-anchor="middle" opacity="0.65">
    <text x="61"  y="36" fill="currentColor">OLTP</text>
    <text x="169" y="36" fill="currentColor">WAREHOUSE</text>
    <text x="277" y="36" fill="currentColor">DATA LAKE</text>
    <text x="385" y="36" fill="currentColor">CLOUD DW</text>
    <text x="493" y="36" fill="currentColor">LAKEHOUSE</text>
    <text x="600" y="36" fill="currentColor">LAKEBASE</text>
  </g>
  <g font-size="8.5" text-anchor="middle" fill="currentColor" opacity="0.45">
    <text x="61"  y="50">1970–88</text>
    <text x="169" y="50">1988–2006</text>
    <text x="277" y="50">2006–13</text>
    <text x="385" y="50">2012–18</text>
    <text x="493" y="50">2019–24</text>
    <text x="600" y="50">2025→</text>
  </g>
  <!-- key systems inside bands -->
  <g font-size="8.6" text-anchor="middle" fill="currentColor">
    <text x="61"  y="86" opacity=".8">Codd 1970</text>
    <text x="61"  y="99" opacity=".55">Oracle · DB2</text>
    <text x="61"  y="112" opacity=".55">Inmon DW 1988</text>

    <text x="169" y="86" opacity=".8">Kimball · Teradata</text>
    <text x="169" y="99" opacity=".55">“OLAP” — Codd 1993</text>
    <text x="169" y="112" opacity=".55">SSAS · Netezza</text>

    <text x="277" y="86" opacity=".8">Hadoop · S3 (2006)</text>
    <text x="277" y="99" opacity=".55">“data lake” Dixon 2010</text>
    <text x="277" y="112" opacity=".55">Hive · HDFS</text>

    <text x="385" y="86" opacity=".8">Redshift 2012</text>
    <text x="385" y="99" opacity=".55">Snowflake GA 2014–15</text>
    <text x="385" y="112" opacity=".55">BigQuery · Aurora</text>

    <text x="493" y="86" opacity=".8">Delta 2019 · Iceberg</text>
    <text x="493" y="99" opacity=".55">CIDR paper 2021</text>
    <text x="493" y="112" opacity=".55">Polaris · S3 Tables ’24</text>

    <text x="600" y="86" fill="#7d8f6f">Neon → Lakebase ’25</text>
    <text x="600" y="99" fill="#7d8f6f" opacity=".8">Snowflake Postgres ’25</text>
    <text x="600" y="112" fill="#7d8f6f" opacity=".8">MCP · LTAP</text>
  </g>
  <!-- ticks -->
  <g stroke="currentColor" stroke-width="1" opacity="0.35">
    <line x1="61" y1="138" x2="61" y2="162"/><line x1="169" y1="138" x2="169" y2="162"/><line x1="277" y1="138" x2="277" y2="162"/><line x1="385" y1="138" x2="385" y2="162"/><line x1="493" y1="138" x2="493" y2="162"/><line x1="600" y1="138" x2="600" y2="162"/>
  </g>
  <g fill="currentColor">
    <circle cx="61" cy="150" r="2.6"/><circle cx="169" cy="150" r="2.6"/><circle cx="277" cy="150" r="2.6"/><circle cx="385" cy="150" r="2.6"/><circle cx="493" cy="150" r="2.6"/><circle cx="600" cy="150" r="3.4" fill="#93a883"/>
  </g>
  <!-- the pain each left behind (below) -->
  <g font-size="8.4" text-anchor="middle" fill="#a9705c">
    <text x="61"  y="178">reports strangle</text><text x="61"  y="189">the prod database</text>
    <text x="169" y="178">T+1, on-prem</text><text x="169" y="189">scale &amp; cost</text>
    <text x="277" y="178">swamps; no ACID,</text><text x="277" y="189">no governance</text>
    <text x="385" y="178">ML left out;</text><text x="385" y="189">data copied again</text>
    <text x="493" y="178">vendor silos; not</text><text x="493" y="189">built for OLTP</text>
  </g>
  <g font-size="8.4" text-anchor="middle" fill="#7d8f6f">
    <text x="600" y="178">open? fast?</text><text x="600" y="189">agentic — TBD</text>
  </g>
  <!-- captions -->
  <text x="10" y="216" font-size="8.6" fill="currentColor" opacity=".5">solved: safe concurrent transactions</text>
  <text x="10" y="232" font-size="8.6" fill="currentColor" opacity=".5">each band = what the previous band's pain produced</text>
  <text x="650" y="232" font-size="8.6" text-anchor="end" fill="#93a883">driver today: AI agents as data consumers</text>
</svg>
  <figcaption class="mt-2 text-center text-xs text-stone-500 dark:text-stone-400">{caption}</figcaption>
</figure>
