---
interface Props { caption: string }
const { caption } = Astro.props;
const rows = [
  { label: "Interfaces", note: "chat & apps · MCP Apps · embedded agent UX", own: false },
  { label: "Agents", note: "LangGraph · OpenAI/Google Agents SDK · A2A delegation · memory (Mem0/Letta)", own: true },
  { label: "Context", note: "RAG: hybrid BM25+vectors+rerank · GraphRAG · semantic layer (Ossie/dbt) · skills (SKILL.md)", own: true },
  { label: "Tools", note: "MCP servers: GitHub · Playwright · Postgres · warehouse · search", own: false },
  { label: "Data platform", note: "Iceberg v3 + REST catalog · Fivetran/dbt/CDC · Lakebase Postgres · Lance (multimodal)", own: false },
  { label: "Inference & eval", note: "vLLM/SGLang · Together/Fireworks/Modal · BFCL/tau-bench · Langfuse/Braintrust", own: false },
];
---
<figure class="not-prose my-8">
  <div class="rounded-2xl border border-stone-200 bg-gradient-to-b from-white to-stone-100/60 p-5 dark:border-stone-800 dark:from-zinc-900 dark:to-zinc-950 sm:p-6">
    <div class="mb-3 flex items-end justify-between font-mono text-[10px] uppercase tracking-[0.2em]">
      <span class="text-[#7d8f6f] dark:text-[#a8bd97]">← you build: context & the loop</span>
      <span class="text-stone-400 dark:text-stone-500">you rent: everything else →</span>
    </div>
    <div class="space-y-1.5">
      {rows.map((r) => (
        <div class="flex items-stretch gap-2">
          <div class={`flex-1 rounded-lg border px-4 py-2.5 ${r.own ? "border-[#cfd8c6] bg-[#eef1e8] dark:border-[#3a4433] dark:bg-[#242b20]" : "border-stone-200 bg-white dark:border-stone-800 dark:bg-zinc-900"}`}>
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-0.5">
              <span class="w-32 shrink-0 font-mono text-[10.5px] uppercase tracking-wider text-stone-700 dark:text-stone-200">{r.label}</span>
              <span class="font-mono text-[11px] leading-relaxed text-stone-400 dark:text-stone-500">{r.note}</span>
            </div>
          </div>
          <span class={`w-1.5 rounded-full ${r.own ? "bg-[#93a883]" : "bg-stone-200 dark:bg-stone-800"}`} title={r.own ? "your moat" : "commodity"}></span>
        </div>
      ))}
    </div>
  </div>
  <figcaption class="mt-3 text-center text-xs text-stone-500 dark:text-stone-400">{caption}</figcaption>
</figure>
