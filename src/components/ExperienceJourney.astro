---
import cmuLogo from "../assets/cmu.png?url";
import usbankLogo from "../assets/usbank.png?url";
interface Stop { co: string; role: string; txt?: string; items?: string[]; urls?: string[]; mark: string; interchange?: string; latest?: boolean }
const logoFor = (host: string) => host.includes("cmu.edu") ? cmuLogo : host.includes("usbank.com") ? usbankLogo : null;
const accent = "#03aa5c"; // ink + single green accent, typesafe style
const work: Stop[] = [
  { co: "International Atomic Energy Agency", role: "Senior Data Engineer / Architect · Vienna", mark: "IA", urls: ["https://www.iaea.org"], latest: true,
    items: [
      "Architected and built, hands-on, SG Lake — a greenfield, open-source, air-gapped lakehouse on Kubernetes consolidating Safeguards data to power analytics and AI.",
      "Designed and authored the platform architecture and white paper, audited and validated by PwC against all five Well-Architected Framework pillars.",
      "Develop and operate production ingestion services, Airflow pipelines and dbt models on Apache Iceberg, with Trino for federated query and Spark for transformation; the platform is in production, onboarding multiple projects and teams.",
      "Built the observability stack — Prometheus and Grafana SLOs for platform health, pipeline reliability and data contracts — and data quality and cataloging with dbt tests, Great Expectations and OpenMetadata lineage; the Gold layer is the single source of truth for the Data Science and AI teams.",
    ] },
  { co: "Reach Financial", role: "Lead Data Engineer · New York", mark: "RF", urls: ["https://www.reachfinancial.com"],
    txt: "Technical lead and hands-on engineer: owned data strategy and roadmap while writing production code. Delivered AI products for credit scoring, loan origination and risk assessment, supplying the ML team with contract-tested feature tables. Built production Snowflake, dbt and Dagster pipelines and a domain-driven Data Mesh; resolved a persistent Salesforce-to-Snowflake dynamic pricing sync issue." },
  { co: "Kaia Health", role: "Lead Data Engineer · New York · HQ Munich", mark: "KH", urls: ["https://www.kaiahealth.com"], interchange: "acquired by Sword Health",
    txt: "Technical lead: architected, developed and operated the production Snowflake platform behind AI-driven musculoskeletal therapy. Led the Redshift-to-Snowflake migration end to end, designing Medallion and Lambda architectures for AI model training. Built Airflow and dbt pipelines feeding proprietary AI algorithms, with Great Expectations checks guarding production ML models." },
  { co: "Thinx", role: "Lead Data Engineer · New York", mark: "TX", urls: ["https://shethinx.com"], interchange: "acquired by Kimberly-Clark",
    txt: "Architected and developed the data platform from scratch on Airflow, AWS S3 and Snowflake; integrated vendor systems including Tatari, NetSuite ERP, Loop, Friendbuy and FormKeep. Set reusable pipeline patterns, containerized AWS deployments and CI/CD." },
  { co: "N26", role: "Senior Data Engineer · New York / Berlin · HQ Berlin", mark: "N2", urls: ["https://n26.com"],
    txt: "Architected, developed and administered the production U.S. data platform (PostgreSQL, custom data pipelines, Metabase) as part of the core Berlin-based global data team. Partnered with Compliance on fraud-risk audits, mitigation systems and regulatory workflows for the U.S. banking entity." },
  { co: "Cherre", role: "Senior Data Engineer · New York", mark: "CH", urls: ["https://www.cherre.com"],
    txt: "Core engineer on the award-winning Connected Data Platform; developed production pipelines ingesting NYC government records and third-party APIs on GCP (BigQuery, Airflow, GKE, Looker). Built entity resolution and a master metadata layer linking addresses, tax assessments and transactions into a real-estate knowledge graph." },
  { co: "ABC Fitness Solutions", role: "Lead Data Architect · New York", mark: "AB", urls: ["https://www.abcfitness.com"], interchange: "acquired by Thomas Bravo",
    txt: "Led an 8-person data team plus offshore contractors, reporting to the CTO, while hands-on in architecture and code. Drove the monolith-to-microservices migration; developed the cloud data warehouse and PCI-compliant data standards on Amazon RDS, Redshift and Domo." },
  { co: "Consulting", role: "United States / global", mark: "CO", urls: ["https://www.dell.com", "https://www.mckesson.com", "https://www.usbank.com"],
    txt: "Dell EMC (Senior Big Data Consultant): Greenplum MPP implementations for NYSE Euronext, Orbitz, Wellington Management, KNotice and INTTRA. McKesson / RelayHealth (Senior Research Software Engineer): HIPAA-compliant data systems. U.S. Bank / Elavon (Senior Software Engineer): bank-acquisition data migrations covering $2B+ revenue. Aloha Data (Principal Consultant): big data and analytics for PepsiCo, Federal Reserve Bank of Philadelphia, Australian Taxation Office, BC Hydro and the U.S. Department of Defense." },
];
const school: Stop[] = [
  { co: "University of Texas at Austin", role: "M.S. Artificial Intelligence · in progress", mark: "UT", urls: ["https://www.utexas.edu"], latest: true },
  { co: "University of Texas at Austin", role: "Post-graduate, AI & Machine Learning", mark: "UT", urls: ["https://www.utexas.edu"] },
  { co: "Carnegie Mellon University", role: "M.S. Software Engineering", mark: "CM", urls: ["https://www.cmu.edu"] },
  { co: "Franklin University", role: "B.S. Computer Science", mark: "FU", urls: ["https://www.franklin.edu"] },
];
const skills: [string, string[]][] = [
  ["Lakehouse", ["Apache Iceberg", "Lakekeeper", "Trino", "DuckDB", "Parquet", "MinIO", "Ceph"]],
  ["AI & ML", ["PyTorch", "MLflow", "LangGraph", "Hugging Face", "vLLM", "RAG", "MCP", "pgvector"]],
  ["Warehouses & Databases", ["Snowflake", "Databricks", "BigQuery", "Redshift", "Oracle", "PostgreSQL", "Neo4j"]],
  ["Pipelines", ["Airflow", "Dagster", "dbt", "SQLMesh", "Spark", "Kafka", "Flink", "Fivetran", "dlt"]],
  ["Quality & Observability", ["Data Contracts", "OpenMetadata", "Great Expectations", "Prometheus", "Grafana", "Sentry"]],
  ["DevOps & IaC", ["Kubernetes", "Helm", "Docker", "Terraform", "Argo CD", "GitHub Actions"]],
  ["Cloud", ["AWS", "GCP", "Azure"]],
  ["Architecture", ["Data Mesh", "Medallion", "Lambda / Kappa", "Dimensional Modeling", "Microservices"]],
  ["Languages", ["Python", "SQL", "PL/SQL", "Bash", "Java", "C++"]],
];
---
<div class="space-y-8">
  {([["Work", work], ["Education", school]] as [string, Stop[]][]).map(([name, list]) => (
    <div>
      <h3 class="mb-3 font-mono text-[10px] uppercase tracking-[0.2em] text-stone-400 dark:text-stone-500">{name}</h3>
      <div class="relative">
        <div class="absolute left-[15px] top-3 bottom-3 w-0.5 rounded" aria-hidden="true"
          style={`background:${accent}` + "; opacity:.3"}></div>
        <ol class="space-y-4">
          {list.map((st) => (
            <li class="stop group relative pl-10">
              <span class="absolute left-[7px] top-4 z-10 grid h-4 w-4 place-items-center rounded-full border-2 transition-transform duration-300 group-hover:scale-125" style={`background:#fefefe;border-color:${accent}`}>
                {st.latest && <span class="pulse-ring absolute inset-0 rounded-full" style={`border:1.5px solid ${accent}`}></span>}
                <span class="h-1.5 w-1.5 rounded-full bg-[#93a883] dark:bg-[#03aa5c]"></span>
              </span>
              <div class="rounded-xl border border-[#dedede] bg-[#fefefe] px-4 py-3 shadow-[0_1px_3px_rgba(0,0,0,0.05)] transition-all duration-300 group-hover:-translate-y-0.5 group-hover:shadow-md dark:border-stone-800 dark:bg-zinc-900">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                  {(st.urls ?? []).map((u) => (
                    <span class="relative grid h-9 w-9 shrink-0 place-items-center overflow-hidden rounded-lg border border-stone-200 bg-white font-mono text-[11px] font-bold text-stone-500 dark:border-stone-700 dark:bg-zinc-800 dark:text-stone-300">
                      <img src={logoFor(new URL(u).hostname) ?? `https://www.google.com/s2/favicons?sz=64&domain=${new URL(u).hostname}`} alt="" class="logo absolute inset-0 h-full w-full object-contain p-1" loading="lazy" width="36" height="36" />
                      <span class="fallback">{st.mark}</span>
                    </span>
                  ))}
                  <div class="min-w-0 flex-1">
                    <h3 class="text-[15px] font-semibold text-stone-800 dark:text-stone-100">{st.co}
                      {st.interchange && <span class="ml-2 align-middle rounded-full border px-2 py-0.5 font-mono text-[9px] uppercase tracking-wider" style={`border-color:${accent}`}>⊚ {st.interchange}</span>}
                    </h3>
                    <p class="font-mono text-[11px] text-stone-400 dark:text-stone-500">{st.role}</p>
                  </div>
                </div>
                {st.txt && <p class="mt-2 text-[14px] leading-relaxed text-stone-600 dark:text-stone-300">{st.txt}</p>}
                {st.items && (
                  <ul class="mt-2 list-disc space-y-1.5 pl-5 text-[14px] leading-relaxed text-stone-600 dark:text-stone-300">
                    {st.items.map((it) => <li>{it}</li>)}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  ))}
  <div class="rounded-xl border border-[#dedede] bg-[#fefefe] p-5 shadow-[0_1px_3px_rgba(0,0,0,0.05)] dark:border-stone-800 dark:bg-zinc-900 sm:p-7">
    <h3 class="font-mono text-[10px] uppercase tracking-[0.2em] text-stone-400 dark:text-stone-500">Skills</h3>
    <dl class="mt-4 space-y-4">
      {skills.map(([name, items]) => (
        <div class="flex flex-col gap-2 sm:flex-row sm:gap-5">
          <dt class="shrink-0 font-mono text-[11px] uppercase tracking-wider text-stone-500 dark:text-stone-400 sm:w-[170px] sm:pt-1">{name}</dt>
          <dd class="flex flex-wrap gap-1.5">
            {items.map((it) => (
              <span class="rounded-full border border-[#dedede] bg-white px-2.5 py-0.5 text-[12.5px] text-stone-600 dark:border-stone-700 dark:bg-zinc-800 dark:text-stone-300">{it}</span>
            ))}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</div>

<style>
  .pulse-ring { animation: pring 2.8s ease-out infinite; }
  @keyframes pring {
    0% { transform: scale(1); opacity: 0.8; }
    70%, 100% { transform: scale(2.6); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pulse-ring { animation: none; opacity: 0; }
  }
</style>

<script>
  document.querySelectorAll<HTMLImageElement>("img.logo").forEach((img) => {
    const fb = img.parentElement?.querySelector(".fallback");
    img.addEventListener("error", () => img.remove());
    img.addEventListener("load", () => {
      if (img.naturalWidth > 1 && fb) fb.style.display = "none";
      else img.remove();
    });
    if (img.complete) { if (img.naturalWidth > 1 && fb) fb.style.display = "none"; else img.remove(); }
  });
</script>
